diff --git a/ext/src/cppformat/format.cc b/ext/src/cppformat/format.cc
index baa97ef..a8f02e7 100644
--- a/ext/src/cppformat/format.cc
+++ b/ext/src/cppformat/format.cc
@@ -137,7 +137,7 @@ int safe_strerror(
     int error_code, char *&buffer, std::size_t buffer_size) FMT_NOEXCEPT(true) {
   assert(buffer != 0 && buffer_size != 0);
   int result = 0;
-#ifdef _GNU_SOURCE
+#if defined(_GNU_SOURCE) && !defined(__EMSCRIPTEN__)  // musl: XSI strerror_r
