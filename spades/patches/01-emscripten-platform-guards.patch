diff --git a/ext/src/easel/esl_cpu.c b/ext/src/easel/esl_cpu.c
index 0957831..b170cb0 100644
--- a/ext/src/easel/esl_cpu.c
+++ b/ext/src/easel/esl_cpu.c
@@ -203,6 +203,12 @@ cpu_run_id(uint32_t eax, uint32_t ecx, uint32_t *abcd)
 {
 #if defined(_MSC_VER)
   __cpuidex(abcd, eax, ecx);
+#elif defined(__EMSCRIPTEN__)
+  /* no cpuid: report SSE+SSE2 (edx 25,26) and SSE4.1 (ecx 19), which emscripten emulates */
+  (void)ecx;
+  abcd[0] = abcd[1] = 0;
+  abcd[2] = (eax == 1) ? (1u << 19) : 0;
+  abcd[3] = (eax == 1) ? ((1u << 25) | (1u << 26)) : 0;
 #else
   uint32_t ebx = 0;
   uint32_t edx = 0;
